# Puerto donde escucha la API
PORT=3001

# Cadena de conexión a PostgreSQL
# Formato: postgres://usuario:contraseña@host:puerto/base_de_datos
DATABASE_URL=postgres://postgres:tu_contraseña@localhost:5432/cultura_ciudadana

# Origen permitido para CORS (URL del frontend)
CORS_ORIGIN=http://localhost:5173

# Entorno de ejecución: development | production
NODE_ENV=development
