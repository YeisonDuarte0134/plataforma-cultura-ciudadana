# Puerto donde escucha la API
PORT=3001

# Cadena de conexión a PostgreSQL
# Formato: postgres://usuario:contraseña@host:puerto/base_de_datos
DATABASE_URL=postgres://postgres:tu_contraseña@localhost:5432/cultura_ciudadana

# Base de datos exclusiva para las pruebas automatizadas (npm test la crea y migra)
DATABASE_URL_PRUEBAS=postgres://postgres:tu_contraseña@localhost:5432/cultura_ciudadana_pruebas

# Origen permitido para CORS (URL del frontend)
CORS_ORIGIN=http://localhost:5173

# Entorno de ejecución: development | production
NODE_ENV=development

# Firebase Admin SDK
# Ruta al JSON de la cuenta de servicio (NUNCA dentro del repositorio)
GOOGLE_APPLICATION_CREDENTIALS=C:\ruta\fuera\del\repo\cuenta-de-servicio.json
# Bucket de Firebase Storage del proyecto
FIREBASE_STORAGE_BUCKET=plataforma-cultura-ciudadana.firebasestorage.app

# Secreto para firmar los tokens de asistencia por QR (cualquier cadena larga y aleatoria)
QR_JWT_SECRETO=cambiar-por-un-secreto-aleatorio
