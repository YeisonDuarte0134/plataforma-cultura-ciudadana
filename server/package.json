{
  "name": "cultura-ciudadana-server",
  "version": "0.1.0",
  "description": "API REST de la plataforma de laboratorios de cultura ciudadana (Express + PostgreSQL)",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "migrar": "node-pg-migrate up",
    "migrar:revertir": "node-pg-migrate down",
    "migrar:crear": "node-pg-migrate create",
    "pretest": "node scripts/preparar-bd-pruebas.js",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "firebase-admin": "^14.2.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "node-pg-migrate": "^7.9.0",
    "pg": "^8.13.1"
  },
  "allowScripts": {
    "@firebase/util@1.15.1": true,
    "protobufjs@7.6.5": true,
    "unrs-resolver@1.12.2": true
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "jest": "^30.4.2",
    "supertest": "^7.2.2"
  }
}
